generator usersClient {
    provider = "prisma-client-js"
    output   = "../../node_modules/@prisma-custom/users"
}

datasource usersDb {
    provider = "mongodb"
    url      = env("USERS_DB_URI") // This warning is for v7, you're on v6
}

// OAuth Account Linking Model
model Account {
  id            String    @id @default(auto()) @map("_id") @usersDb.ObjectId
  userId        String    @usersDb.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // OAuth Provider Info
  provider      String    // "google", "github", "linkedin"
  providerAccountId String // Unique ID from provider
  
  // Additional OAuth Data
  accessToken   String?   @usersDb.String
  refreshToken  String?   @usersDb.String
  expiresAt     Int?      // Token expiration timestamp
  tokenType     String?
  scope         String?   // Requested scopes
  
  // User Info from Provider
  email         String?
  phoneNumber String?
  name          String?
  image         String?
  
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@unique([provider, providerAccountId])
  @@index([userId])

  @@map("user-account")
}

// Session Management Model
model Session {
  id            String    @id @default(auto()) @map("_id") @usersDb.ObjectId
  userId        String    @usersDb.ObjectId
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  token         String    @unique  // JWT token
  userAgent     String?             // Browser info
  ipAddress     String?             // For security tracking
  
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  
  @@index([userId])

  @@map("user-session")
}

model User {
    // MongoDB requires this exact setup for the primary key
    id                          String         @id @default(auto()) @map("_id") @usersDb.ObjectId
    email                       String?         @unique
    phoneNumber String?
    password                    String?
    passwordResetToken          String?
    passwordResetTokenExpiresAt DateTime?
    emailVerified               Boolean        @default(false)
    accounts               Account[]
    sessions Session[]
    role                        String         @default("USER")
    accountStatus               String         @default("PENDING_VERIFICATION")
    createdAt                   DateTime       @default(now())
    updatedAt                   DateTime       @updatedAt
    lastLoginAt                 DateTime       @default(now())

    // 1-to-1 Relation (Non-defining side) 
    userProfile UserProfile?

    @@map("user-auth")
}

model UserProfile {
    id          String  @id @default(auto()) @map("_id") @usersDb.ObjectId
    // Personal details
    email       String  @unique
    firstName   String
    lastName    String
    bio         String?
    imageUrl    String?
    phoneNumber String?

    // Relationship to User (1:1)
    userId String @unique @usersDb.ObjectId
    user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

    // Relationship to Addresses (1:many)
    addresses Address[]

    // Array of Technology IDs (cross-database references)
    // Store as strings since they're from a different DB
    technologyIds String[] @usersDb.ObjectId

    // Metadata
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@map("user-profile")
}

// Address types enum
enum AddressType {
    HOME
    WORK
    OTHER
}

model Address {
    id       String  @id @default(auto()) @map("_id") @usersDb.ObjectId
    // Address details
    address1 String
    address2 String?
    address3 String?
    city     String
    pincode  String
    state    String
    country  String

    // Address type (home, work, etc.)
    type AddressType @default(HOME)

    // Relationship to UserProfile
    userProfileId String      @usersDb.ObjectId
    userProfile   UserProfile @relation(fields: [userProfileId], references: [id], onDelete: Cascade)

    // Timestamps
    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    @@index([userProfileId])
    @@map("user-address")
}
