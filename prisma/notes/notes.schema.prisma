generator notesClient {
  provider = "prisma-client-js"
  output   = "../../node_modules/@prisma-custom/notes"
}

datasource notesDb {
  provider = "mongodb"
  url      = env("NOTES_DB_URI")
}

enum NoteAuthorRole {
  USER
  ADMIN
}

enum NoteVisibility {
  PRIVATE
  PUBLIC
}

enum SubscriptionTier {
  FREE
  S1
  S2
  S3
}

/// Embedded Q&A pair — stored as an array inside the Note document.
/// No separate collection; avoids extra round-trips.
type QuestionAnswer {
  id       String // client-generated UUID (crypto.randomUUID)
  question String
  /// Answer text encrypted at rest (AES-256-GCM). Stored as 'iv:authTag:ciphertext' (base64-joined).
  answer   String
  order    Int    @default(0)
}

model Note {
  id         String         @id @default(auto()) @map("_id") @notesDb.ObjectId

  /// Maps to User.id (@prisma-custom/users → user-auth collection).
  /// Same pattern as UserProfile.userId — cross-DB reference, no Prisma relation possible.
  /// Enforced at application layer: extract userId from JWT, store here on create.
  authorId   String         @notesDb.ObjectId
  authorRole NoteAuthorRole @default(USER)

  /// Min 30 characters — enforced via Zod (CreateNoteSchema)
  title       String
  /// Min 100 characters — enforced via Zod (CreateNoteSchema)
  description String

  /// Maps to Technology.id (@prisma-custom/technologies).
  /// Cross-DB reference, no Prisma relation possible — same pattern as authorId.
  /// Enforced at application layer: validated against the technologies DB on create/update.
  technologyId String @notesDb.ObjectId

  /// All Q&A pairs embedded in the note document.
  questions QuestionAnswer[]

  /// USER notes are always PRIVATE.
  /// ADMIN notes can be PUBLIC (visible to all) or PRIVATE (admin-only).
  visibility NoteVisibility @default(PRIVATE)

  /// Minimum subscription tier required to view this note when visibility is PUBLIC.
  /// Only meaningful when visibility = PUBLIC. USER notes always have FREE (the default).
  requiredTier SubscriptionTier @default(FREE)

  /// Soft delete — set true instead of hard-deleting.
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([authorId])
  @@index([authorId, isArchived])
  @@index([authorRole, visibility])
  @@index([authorId, authorRole, isArchived])
  @@index([technologyId])
  /// Supports cursor pagination for getUserNotes (sorted updatedAt desc, id tiebreak).
  @@index([authorId, isArchived, updatedAt])
  /// Supports cursor pagination for getPublicAdminNotes and tiered listing.
  @@index([authorRole, visibility, requiredTier, updatedAt])
  @@map("notes")
}
